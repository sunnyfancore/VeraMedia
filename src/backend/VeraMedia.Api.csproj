<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\frontend\</SpaRoot>
    <SpaDist>$(SpaRoot)dist\</SpaDist>
    <FrontendWwwRoot>$(MSBuildProjectDirectory)\wwwroot\</FrontendWwwRoot>
    <NpmCommand Condition="'$(OS)' == 'Windows_NT'">npm.cmd</NpmCommand>
    <NpmCommand Condition="'$(OS)' != 'Windows_NT'">npm</NpmCommand>
    <SkipFrontendBuild Condition="'$(SkipFrontendBuild)' == ''">false</SkipFrontendBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.22" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.25" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Markdig" Version="0.38.0" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\scripts\export-ppt-video.sh" Link="scripts\export-ppt-video.sh" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <Target Name="BuildFrontendAssets" AfterTargets="Build" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Message Text="Building frontend and syncing files into wwwroot..." Importance="high" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="$(NpmCommand) ci" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="$(NpmCommand) run build" />
    <ItemGroup>
      <OldFrontendFiles Include="$(FrontendWwwRoot)assets\**\*.*" />
      <OldFrontendFiles Include="$(FrontendWwwRoot)index.html" />
      <OldFrontendFiles Include="$(FrontendWwwRoot)favicon.svg" />
      <OldFrontendFiles Include="$(FrontendWwwRoot)icons.svg" />
    </ItemGroup>
    <Delete Files="@(OldFrontendFiles)" />
    <ItemGroup>
      <FrontendDistFiles Include="$(SpaDist)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendDistFiles)" DestinationFiles="@(FrontendDistFiles->'$(FrontendWwwRoot)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
